# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# config/settings.py loads these via pydantic-settings.

# ---- Postgres (pgvector) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me

# ---- Redis (semantic cache + conversation state) ----
REDIS_URL=redis://localhost:6379/0

# ---- OpenSearch (hybrid search) ----
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=documents

# ---- Models ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- LLM serving (Phase 7) ----
# Point at your vLLM OpenAI-compatible endpoint, or a hosted API while iterating.
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
LLM_API_KEY=not_needed_for_local_vllm

# ---- Web search tool (Phase 3 web_agent) ----
WEB_SEARCH_API_KEY=

# ---- App ----
LOG_LEVEL=INFO
